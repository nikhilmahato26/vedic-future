# VedIntel AstroAPI key — https://vedintelastroapi.com/dashboard/api-keys
# Copy this file to .env.local for local development.
# In production set the same variable in Vercel → Settings → Environment Variables.
#
# NOTE: no VITE_ prefix. That is deliberate — a VITE_ variable gets inlined into the
# browser bundle, which would publish the key to anyone who views source.
VEDINTEL_API_KEY=vai_live_xxxxxxxxxxxxxxxx
